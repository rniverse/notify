# Server
PORT=3001
NODE_ENV=development

DATABASE_URL=

# Retry cron: how often (minutes) to sweep `pending` rows.
NOTIFICATION_RETRY_INTERVAL_MINUTES=5
# Metrics cron: hour of day (0-23, server-local time) to run the nightly
# failure report.
NOTIFICATION_METRICS_CRON_HOUR=0

RESEND_API_KEY=

LOG_LEVEL=info

