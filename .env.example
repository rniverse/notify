# Server
PORT=3001
NODE_ENV=development
# Client name on every connection (Postgres application_name, kafkajs clientId). Required.
INSTANCE_NAME=notify

DATABASE_URL=

# Retry cron: how often to sweep `pending` rows (compact duration string).
NOTIFICATION_RETRY_EVERY=5m
# Metrics cron: hour of day (0-23, server-local time) to run the nightly
# failure report.
NOTIFICATION_METRICS_CRON_HOUR=0

RESEND_API_KEY=
RESEND_FROM_EMAIL=

LOG_LEVEL=info

# Kafka/Redpanda broker config — see notify-spec.md §15
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CA_CERTIFICATE=

# One topic, shared: the `notifier` producer publishes to it, the
# `notifications` consumer reads from it (required).
KAFKA_NOTIFICATIONS_TOPIC_NAME=notifications
# Link names on the Kafka connector (optional) — defaults shown.
# KAFKA_NOTIFICATIONS_PRODUCER_NAME=notifier
# KAFKA_NOTIFICATIONS_CONSUMER_NAME=notifications
# Consumer group (optional, default notify-consumer).
KAFKA_NOTIFICATIONS_CONSUMER_GROUP_ID=notify-consumer-group
# How often a down Kafka connection / producer / consumer is retried (optional, default 30s).
# KAFKA_RECOVER_EVERY=30s
