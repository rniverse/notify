{
	"name": "notify",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome check --write",
		"start": "bun run src/index.ts",
		"dev": "bun run --watch --inspect=9009 src/index.ts",
		"db:main": "drizzle-kit --config drizzle.config.ts",
		"dbsync:main": "source .env && rm -rf src/db/migrations && bun run db:main introspect && bun run db:main generate && bun run db:main migrate",
		"generate-keys": "bun run src/scripts/generate-keys.ts",
		"db:test:setup": "bun run src/scripts/setup-test-db.ts",
		"pretest": "bun run db:main generate && bun run db:test:setup",
		"test": "NODE_ENV=test bun test",
		"test:watch": "NODE_ENV=test bun test --watch"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@rniverse/connectors": "github:rniverse/connectors#dist",
		"@rniverse/shared": "github:rniverse/shared#dist",
		"@rniverse/utils": "github:rniverse/utils#dist",
		"@valibot/to-json-schema": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.30",
		"kafkajs": "^2.2.4",
		"postgres": "^3.4.9",
		"resend": "^6.26.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.1",
		"bun-types": "^1.4.0",
		"drizzle-kit": "^0.31.10"
	}
}
